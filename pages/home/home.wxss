page {
  box-sizing: border-box;
  min-height: 100vh;
  background: #f4f5f1;
  padding-bottom: calc(env(safe-area-inset-bottom) + 112rpx);
}

.dinner-home {
  padding: 28rpx 24rpx 40rpx;
}

.hero {
  background: #26332c;
  border-radius: 8rpx;
  color: #ffffff;
  padding: 32rpx;
}

.hero-top,
.summary-card,
.browse-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.eyebrow {
  color: #b8d8c2;
  font-size: 22rpx;
  letter-spacing: 0;
  line-height: 32rpx;
}

.title {
  font-size: 48rpx;
  font-weight: 700;
  line-height: 64rpx;
  margin-top: 8rpx;
}

.menu-pill {
  background: rgba(255, 255, 255, 0.16);
  border: 1rpx solid rgba(255, 255, 255, 0.28);
  border-radius: 8rpx;
  color: #ffffff;
  font-size: 24rpx;
  line-height: 34rpx;
  padding: 12rpx 18rpx;
}

.subtitle {
  color: #dce7df;
  font-size: 28rpx;
  line-height: 42rpx;
  margin-top: 20rpx;
}

.hero-actions {
  display: grid;
  gap: 16rpx;
  grid-template-columns: 1fr 1fr;
  margin-top: 28rpx;
}

.primary-btn,
.secondary-btn {
  border-radius: 8rpx;
  font-size: 28rpx;
  font-weight: 600;
  height: 84rpx;
  line-height: 84rpx;
  margin: 0;
}

.primary-btn {
  background: #f3c969;
  color: #1f241f;
}

.secondary-btn {
  background: #ffffff;
  color: #26332c;
}

.summary-card {
  background: #ffffff;
  border-radius: 8rpx;
  margin-top: 24rpx;
  padding: 26rpx 28rpx;
}

.summary-title {
  color: #1f241f;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 44rpx;
}

.summary-meta {
  color: #69736d;
  font-size: 24rpx;
  line-height: 36rpx;
  margin-top: 6rpx;
}

.dish-grid {
  display: grid;
  gap: 18rpx;
  margin-top: 24rpx;
}

.dish-card {
  background: #ffffff;
  border-radius: 8rpx;
  display: flex;
  overflow: hidden;
}

.dish-image {
  flex-shrink: 0;
  height: 184rpx;
  width: 184rpx;
}

.dish-body {
  flex: 1;
  min-width: 0;
  padding: 20rpx;
}

.dish-name {
  color: #1f241f;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 44rpx;
}

.dish-meta {
  color: #69736d;
  font-size: 24rpx;
  line-height: 34rpx;
  margin-top: 8rpx;
}

.dish-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 14rpx;
}

.dish-tags text {
  background: #eef4e7;
  border-radius: 6rpx;
  color: #48613f;
  font-size: 22rpx;
  line-height: 30rpx;
  padding: 6rpx 10rpx;
}

.browse-row {
  background: #ffffff;
  border-radius: 8rpx;
  margin-top: 24rpx;
  padding: 26rpx 28rpx;
}

.browse-title {
  color: #1f241f;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 42rpx;
}

.browse-desc {
  color: #69736d;
  font-size: 24rpx;
  line-height: 36rpx;
  margin-top: 6rpx;
  max-width: 560rpx;
}
