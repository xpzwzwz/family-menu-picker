page {
  box-sizing: border-box;
  min-height: 100vh;
  background: #f4f5f1;
  padding-bottom: calc(env(safe-area-inset-bottom) + 112rpx);
}

.dinner-home {
  padding: 28rpx 24rpx 40rpx;
}

.hero {
  background: #26332c;
  border-radius: 8rpx;
  color: #ffffff;
  padding: 32rpx;
}

.hero-top,
.summary-card,
.browse-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.eyebrow {
  color: #b8d8c2;
  font-size: 22rpx;
  letter-spacing: 0;
  line-height: 32rpx;
}

.title {
  font-size: 48rpx;
  font-weight: 700;
  line-height: 64rpx;
  margin-top: 8rpx;
}

.menu-pill {
  background: rgba(255, 255, 255, 0.16);
  border: 1rpx solid rgba(255, 255, 255, 0.28);
  border-radius: 8rpx;
  color: #ffffff;
  font-size: 24rpx;
  line-height: 34rpx;
  padding: 12rpx 18rpx;
}

.subtitle {
  color: #dce7df;
  font-size: 28rpx;
  line-height: 42rpx;
  margin-top: 20rpx;
}

.count-row {
  align-items: center;
  color: #dce7df;
  display: flex;
  font-size: 26rpx;
  justify-content: space-between;
  line-height: 40rpx;
  margin-top: 22rpx;
}

.count-stepper {
  color: #1f241f;
  flex-shrink: 0;
}

.count-stepper-button {
  background: #f3c969 !important;
  border-color: #f3c969 !important;
  color: #1f241f !important;
}

.count-stepper-input {
  background: #ffffff !important;
  color: #1f241f !important;
  font-weight: 700 !important;
}

.hero-actions {
  display: grid;
  gap: 16rpx;
  grid-template-columns: 1fr 1fr;
  margin-top: 28rpx;
}

.hero-hint {
  color: rgba(255, 255, 255, 0.78);
  font-size: 22rpx;
  margin-top: 16rpx;
  text-align: center;
}

.primary-btn,
.secondary-btn {
  border-radius: 8rpx;
  font-size: 28rpx;
  font-weight: 600;
  height: 84rpx;
  line-height: 84rpx;
  margin: 0;
}

.primary-btn {
  background: #f3c969;
  color: #1f241f;
}

.secondary-btn {
  background: #ffffff;
  color: #26332c;
}

/* 光盘打卡 —— 一行细条，避免和首页主操作抢视线 */
.cleanplate-strip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #ffffff;
  border-radius: 8rpx;
  margin-top: 24rpx;
  padding: 18rpx 24rpx;
}

.cp-line {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.cp-flame {
  font-size: 30rpx;
  margin-right: 8rpx;
}

.cp-streak {
  color: #1f241f;
  font-size: 26rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.cp-num {
  color: #26332c;
  font-size: 32rpx;
  font-weight: 800;
  padding: 0 2rpx;
}

.cp-dot {
  color: #c9cdc6;
  margin: 0 12rpx;
  flex-shrink: 0;
}

.cp-status {
  color: #69736d;
  font-size: 24rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.cp-pill {
  background: #f3c969;
  color: #1f241f;
  font-size: 24rpx;
  font-weight: 600;
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 26rpx;
  border-radius: 28rpx;
  margin: 0 0 0 16rpx;
  flex-shrink: 0;
}

.cp-pill-ghost {
  background: #eef4e7;
  color: #48613f;
}

.cp-done {
  flex-shrink: 0;
  margin-left: 16rpx;
}

/* 打卡弹层 */
.cp-sheet {
  padding: 20rpx 32rpx calc(env(safe-area-inset-bottom) + 40rpx);
  border-radius: 24rpx 24rpx 0 0;
}

.cp-sheet-handle {
  width: 64rpx;
  height: 8rpx;
  border-radius: 8rpx;
  background: #e3e6e1;
  margin: 0 auto 24rpx;
}

.cp-sheet-title {
  color: #1f241f;
  font-size: 34rpx;
  font-weight: 700;
  text-align: center;
}

.cp-sheet-sub {
  color: #69736d;
  font-size: 26rpx;
  text-align: center;
  margin-top: 10rpx;
}

.cp-sheet-note {
  background: #f4f5f1;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin: 28rpx 0;
}

.cp-sheet-confirm {
  background: #f3c969;
  color: #1f241f;
  font-size: 32rpx;
  font-weight: 700;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  margin: 0;
}

.summary-card {
  background: #ffffff;
  border-radius: 8rpx;
  margin-top: 24rpx;
  padding: 26rpx 28rpx;
}

.summary-title {
  color: #1f241f;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 44rpx;
}

.summary-meta {
  color: #69736d;
  font-size: 24rpx;
  line-height: 36rpx;
  margin-top: 6rpx;
}

.dish-grid {
  display: grid;
  gap: 18rpx;
  margin-top: 24rpx;
}

.dish-card {
  background: #ffffff;
  border-radius: 8rpx;
  display: flex;
  overflow: hidden;
  position: relative;
  border: 2rpx solid transparent;
}

.dish-card.dish-locked {
  border-color: #f3c969;
  box-shadow: 0 0 0 2rpx #f3c969 inset;
}

.lock-badge {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f3f1ec;
  z-index: 2;
}

.lock-badge.lock-on {
  background: #f3c969;
}

.dish-image {
  flex-shrink: 0;
  height: 184rpx;
  width: 184rpx;
}

.dish-body {
  flex: 1;
  min-width: 0;
  padding: 20rpx;
}

.dish-name {
  color: #1f241f;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 44rpx;
  padding-right: 64rpx;
}

.dish-meta {
  color: #69736d;
  font-size: 24rpx;
  line-height: 34rpx;
  margin-top: 8rpx;
}

.dish-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 14rpx;
}

.dish-tags text {
  background: #eef4e7;
  border-radius: 6rpx;
  color: #48613f;
  font-size: 22rpx;
  line-height: 30rpx;
  padding: 6rpx 10rpx;
}

.browse-row {
  background: #ffffff;
  border-radius: 8rpx;
  margin-top: 24rpx;
  padding: 26rpx 28rpx;
}

.browse-title {
  color: #1f241f;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 42rpx;
}

.browse-desc {
  color: #69736d;
  font-size: 24rpx;
  line-height: 36rpx;
  margin-top: 6rpx;
  max-width: 560rpx;
}
