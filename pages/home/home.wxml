<view class="dinner-home">
  <view class="hero">
    <view class="hero-top">
      <view>
        <view class="eyebrow">光盘小分队</view>
        <view class="title">今天吃什么</view>
      </view>
      <view class="menu-pill" bindtap="navToMenu">菜单 {{totalMenuCount}}</view>
    </view>
    <view class="subtitle">随机搭一餐，尽量兼顾荤素和做饭时间。</view>
    <view class="hero-actions">
      <button class="primary-btn" bindtap="randomDinnerSet">随机换一餐</button>
      <button class="secondary-btn" bindtap="addRecommendationToMenu">加入菜单</button>
    </view>
  </view>

  <view class="summary-card" wx:if="{{recommendation}}">
    <view>
      <view class="summary-title">{{recommendation.title}}</view>
      <view class="summary-meta">{{recommendation.totalCookMinutes}} 分钟 · {{recommendationTagText}}</view>
    </view>
    <t-icon name="refresh" size="40rpx" color="#e34d59" bindtap="randomDinnerSet" />
  </view>

  <view class="dish-grid" wx:if="{{recommendation}}">
    <view class="dish-card" wx:for="{{recommendation.dishes}}" wx:key="id" data-id="{{item.id}}" bindtap="goDishDetail">
      <t-image src="{{item.image}}" t-class="dish-image" mode="aspectFill" />
      <view class="dish-body">
        <view class="dish-name">{{item.name}}</view>
        <view class="dish-meta">{{item.cookMinutes}} 分钟 · {{item.difficulty}} · {{item.flavor}}</view>
        <view class="dish-tags">
          <text wx:for="{{item.tags}}" wx:key="*this">{{item}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="browse-row" bindtap="navToDishList">
    <view>
      <view class="browse-title">还是想自己挑？</view>
      <view class="browse-desc">去菜品里按快手菜、荤菜、素菜、汤和主食慢慢选。</view>
    </view>
    <t-icon name="chevron-right" size="40rpx" color="#666" />
  </view>

  <t-toast id="t-toast" />
</view>
