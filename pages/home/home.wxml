<view class="dinner-home">
  <view class="hero">
    <view class="hero-top">
      <view>
        <view class="eyebrow">光盘小分队</view>
        <view class="title">今天吃什么</view>
      </view>
      <view class="menu-pill" bindtap="navToMenu">菜单 {{totalMenuCount}}</view>
    </view>
    <view class="subtitle">随机搭一餐，尽量兼顾荤素和做饭时间。</view>
    <view class="count-row">
      <text>随机 {{recommendationCount}} 道</text>
      <t-stepper
        t-class="count-stepper"
        t-class-input="count-stepper-input"
        t-class-minus="count-stepper-button"
        t-class-plus="count-stepper-button"
        value="{{recommendationCount}}"
        min="{{1}}"
        max="{{10}}"
        integer
        theme="filled"
        size="medium"
        bind:change="onRecommendationCountChange"
      />
    </view>
    <view class="hero-actions">
      <button class="primary-btn" bindtap="randomDinnerSet">随机换一餐</button>
      <button class="secondary-btn" bindtap="addRecommendationToMenu">加入菜单</button>
    </view>
  </view>

  <view class="cleanplate-strip" bindtap="goCheckinRecords">
    <view class="cp-line">
      <text class="cp-flame">🔥</text>
      <text class="cp-streak">连续光盘 <text class="cp-num">{{checkin.streakDays}}</text> 天</text>
      <text class="cp-dot">·</text>
      <text class="cp-status">{{checkin.todayDone ? '今晚已光盘' : '今晚光盘了吗？'}}</text>
    </view>
    <button wx:if="{{!checkin.todayDone}}" class="cp-pill" catchtap="openCheckin">今晚打卡</button>
    <view wx:else class="cp-done"><t-icon name="check-circle-filled" size="36rpx" color="#26332c" /></view>
  </view>

  <view class="summary-card" wx:if="{{recommendation}}">
    <view>
      <view class="summary-title">{{recommendation.title}}</view>
      <view class="summary-meta">{{recommendation.totalCookMinutes}} 分钟 · {{recommendationTagText}}</view>
    </view>
    <t-icon name="refresh" size="40rpx" color="#26332c" bindtap="randomDinnerSet" />
  </view>

  <view class="dish-grid" wx:if="{{recommendation}}">
    <view class="dish-card" wx:for="{{recommendation.dishes}}" wx:key="id" data-id="{{item.id}}" bindtap="goDishDetail">
      <t-image src="{{item.image}}" t-class="dish-image" mode="aspectFill" />
      <view class="dish-body">
        <view class="dish-name">{{item.name}}</view>
        <view class="dish-meta">{{item.cookMinutes}} 分钟 · {{item.difficulty}} · {{item.flavor}}</view>
        <view class="dish-tags">
          <text wx:for="{{item.tags}}" wx:key="*this">{{item}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="browse-row" bindtap="navToDishList">
    <view>
      <view class="browse-title">还是想自己挑？</view>
      <view class="browse-desc">去菜品里按快手菜、荤菜、素菜、汤和主食慢慢选。</view>
    </view>
    <t-icon name="chevron-right" size="40rpx" color="#666" />
  </view>

  <t-popup visible="{{showCheckinPopup}}" placement="bottom" bind:visible-change="onCheckinPopupChange">
    <view class="cp-sheet">
      <view class="cp-sheet-handle"></view>
      <view class="cp-sheet-title">🍽️ 今晚光盘打卡</view>
      <view class="cp-sheet-sub">一家人一起把菜吃光，给今晚记一笔</view>
      <t-textarea
        class="cp-sheet-note"
        value="{{checkinNote}}"
        bind:change="onCheckinNoteInput"
        placeholder="想记一句吗？(可选，比如：红烧肉光速光盘)"
        maxlength="50"
        disableDefaultPadding
      />
      <button class="cp-sheet-confirm" bindtap="confirmCheckin">光盘！</button>
    </view>
  </t-popup>

  <t-toast id="t-toast" />
</view>
