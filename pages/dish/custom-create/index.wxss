page {
  background-color: #f6f4ef;
}

.custom-dish-page {
  min-height: 100vh;
  padding: 28rpx 28rpx 48rpx;
  box-sizing: border-box;
}

.page-head {
  padding: 28rpx 8rpx 24rpx;
}

.eyebrow {
  color: #d54941;
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 0;
}

.title {
  margin-top: 8rpx;
  color: #1f1f1f;
  font-size: 48rpx;
  font-weight: 700;
  line-height: 64rpx;
}

.subtitle {
  margin-top: 12rpx;
  color: #666;
  font-size: 28rpx;
  line-height: 42rpx;
}

.form-section {
  padding: 28rpx 24rpx;
  border-radius: 8rpx;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(31, 31, 31, 0.06);
}

.field {
  margin-bottom: 28rpx;
}

.field:last-child {
  margin-bottom: 0;
}

.field-label {
  margin-bottom: 12rpx;
  color: #333;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 40rpx;
}

.field-input {
  height: 88rpx;
  padding: 0 24rpx;
  border-radius: 8rpx;
  background: #f7f7f7;
  color: #1f1f1f;
  font-size: 28rpx;
  box-sizing: border-box;
}

.field-textarea {
  width: 100%;
  min-height: 180rpx;
  padding: 22rpx 24rpx;
  border-radius: 8rpx;
  background: #f7f7f7;
  color: #1f1f1f;
  font-size: 28rpx;
  line-height: 40rpx;
  box-sizing: border-box;
}

.image-picker {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: 136rpx;
  padding: 16rpx;
  border-radius: 8rpx;
  background: #f7f7f7;
  box-sizing: border-box;
}

.dish-preview,
.image-placeholder {
  width: 104rpx;
  height: 104rpx;
  flex-shrink: 0;
  border-radius: 8rpx;
  overflow: hidden;
}

.image-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff0ee;
}

.image-copy {
  min-width: 0;
}

.image-title {
  color: #1f1f1f;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 40rpx;
}

.image-desc {
  margin-top: 6rpx;
  color: #777;
  font-size: 24rpx;
  line-height: 34rpx;
}

.two-col {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.chip {
  min-height: 64rpx;
  padding: 0 22rpx;
  border-radius: 8rpx;
  background: #f7f7f7;
  color: #555;
  font-size: 26rpx;
  line-height: 64rpx;
  box-sizing: border-box;
}

.chip-active {
  background: #fff0ee;
  color: #d54941;
  font-weight: 600;
}

.footer {
  margin-top: 32rpx;
  padding-bottom: env(safe-area-inset-bottom);
}

.save-btn {
  height: 92rpx;
  border-radius: 8rpx;
  background: #d54941;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 92rpx;
}

.save-btn::after {
  border: 0;
}
