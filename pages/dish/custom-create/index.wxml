<view class="custom-dish-page">
  <view class="page-head">
    <view class="eyebrow">Dish Library</view>
    <view class="title">{{modeTitle}}</view>
    <view class="subtitle">把菜品改成家里习惯的做法，之后选菜和随机搭配都会按这里来。</view>
  </view>

  <view class="form-section">
    <view class="field">
      <view class="field-label">菜名</view>
      <input
        class="field-input"
        value="{{form.name}}"
        placeholder="例如：干煸豆角"
        data-field="name"
        bindinput="updateField"
      />
    </view>

    <view class="field">
      <view class="field-label">菜品图片</view>
      <view class="image-picker" bindtap="chooseImage">
        <t-image wx:if="{{form.image}}" src="{{form.image}}" t-class="dish-preview" mode="aspectFill" />
        <view class="image-placeholder" wx:else>
          <t-icon name="image" size="48rpx" color="#d54941" />
        </view>
        <view class="image-copy">
          <view class="image-title">{{uploadingImage ? '正在保存图片' : '更换图片'}}</view>
          <view class="image-desc">不上传就使用默认占位图</view>
        </view>
      </view>
    </view>

    <view class="field">
      <view class="field-label">分类</view>
      <view class="chip-row">
        <view
          class="chip {{form.category == item.id ? 'chip-active' : ''}}"
          wx:for="{{categoryOptions}}"
          wx:key="id"
          data-value="{{item.id}}"
          bindtap="selectCategory"
        >
          {{item.name}}
        </view>
      </view>
    </view>

    <view class="field two-col">
      <view>
        <view class="field-label">预计分钟</view>
        <input
          class="field-input"
          type="number"
          value="{{form.cookMinutes}}"
          placeholder="20"
          data-field="cookMinutes"
          bindinput="updateField"
        />
      </view>
      <view>
        <view class="field-label">口味</view>
        <input
          class="field-input"
          value="{{form.flavor}}"
          placeholder="咸香"
          data-field="flavor"
          bindinput="updateField"
        />
      </view>
    </view>

    <view class="field">
      <view class="field-label">难度</view>
      <view class="chip-row">
        <view
          class="chip {{form.difficulty == item ? 'chip-active' : ''}}"
          wx:for="{{difficultyOptions}}"
          wx:key="*this"
          data-value="{{item}}"
          bindtap="selectDifficulty"
        >
          {{item}}
        </view>
      </view>
    </view>

    <view class="field">
      <view class="field-label">标签</view>
      <input
        class="field-input"
        value="{{form.tagsText}}"
        placeholder="例如：快手，素菜，下饭"
        data-field="tagsText"
        bindinput="updateField"
      />
    </view>

    <view class="field">
      <view class="field-label">备料</view>
      <input
        class="field-input"
        value="{{form.ingredientsText}}"
        placeholder="例如：豆角，蒜，干辣椒"
        data-field="ingredientsText"
        bindinput="updateField"
      />
    </view>

    <view class="field">
      <view class="field-label">做法步骤</view>
      <textarea
        class="field-textarea"
        value="{{form.stepsText}}"
        placeholder="每行一步，例如：\n豆角切段\n蒜末爆香\n下锅翻炒调味"
        data-field="stepsText"
        bindinput="updateField"
      />
      <view class="step-preview-list" wx:if="{{stepPreviews.length}}">
        <view class="step-preview" wx:for="{{stepPreviews}}" wx:key="text">
          <view class="step-number">{{index + 1}}</view>
          <view class="step-preview-copy">
            <view class="step-preview-text">{{item.text}}</view>
            <view class="step-image-row" bindtap="chooseStepImage" data-index="{{index}}">
              <t-image wx:if="{{item.image}}" src="{{item.image}}" t-class="step-image" mode="aspectFill" />
              <view class="step-image-placeholder" wx:else>
                <t-icon name="image" size="36rpx" color="#d54941" />
              </view>
              <view class="step-image-copy">
                <view class="step-image-title">{{item.image ? '更换步骤图' : '添加步骤图'}}</view>
                <view class="step-image-desc">有图就展示，没图不占位。</view>
              </view>
            </view>
            <button class="remove-step-image" wx:if="{{item.image}}" catchtap="removeStepImage" data-index="{{index}}">移除图片</button>
          </view>
        </view>
      </view>
    </view>

    <view class="field">
      <view class="field-label">备注</view>
      <t-textarea
        value="{{form.notes}}"
        placeholder="例如：豆角要炒熟，少放辣。"
        maxlength="{{80}}"
        data-field="notes"
        bindchange="updateField"
      />
    </view>
  </view>

  <view class="footer">
    <button class="save-btn" bindtap="submitDish">{{submitText}}</button>
  </view>

  <t-toast id="t-toast" />
</view>
