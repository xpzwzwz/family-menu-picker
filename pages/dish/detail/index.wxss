page {
  background: #f6f4ef;
}

.detail-page {
  min-height: 100vh;
  padding: 28rpx 28rpx calc(env(safe-area-inset-bottom) + 132rpx);
  box-sizing: border-box;
}

.hero {
  display: flex;
  gap: 22rpx;
  padding: 24rpx;
  border-radius: 8rpx;
  background: #26332c;
  color: #fff;
  box-sizing: border-box;
}

.hero-image {
  width: 168rpx;
  height: 168rpx;
  flex-shrink: 0;
  border-radius: 8rpx;
  overflow: hidden;
}

.hero-copy {
  flex: 1;
  min-width: 0;
}

.eyebrow {
  color: #f4c45a;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 32rpx;
}

.title {
  margin-top: 10rpx;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 54rpx;
}

.meta {
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 25rpx;
  line-height: 36rpx;
}

.quick-facts {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin-top: 18rpx;
}

.fact,
.section {
  border-radius: 8rpx;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(31, 31, 31, 0.06);
}

.fact {
  padding: 22rpx 8rpx;
  text-align: center;
}

.fact-value {
  color: #1f241f;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 46rpx;
}

.fact-label {
  margin-top: 4rpx;
  color: #777;
  font-size: 22rpx;
  line-height: 32rpx;
}

.section {
  margin-top: 18rpx;
  padding: 24rpx;
  box-sizing: border-box;
}

.section-title {
  color: #1f241f;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 44rpx;
}

.tag-line,
.notes,
.empty-copy {
  margin-top: 12rpx;
  color: #69736d;
  font-size: 26rpx;
  line-height: 40rpx;
}

.ingredient-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
}

.ingredient {
  padding: 8rpx 14rpx;
  border-radius: 8rpx;
  background: #eef4e7;
  color: #48613f;
  font-size: 24rpx;
  line-height: 34rpx;
}

.step-list {
  margin-top: 20rpx;
}

.step {
  display: flex;
  gap: 18rpx;
  padding: 0 0 24rpx;
}

.step:last-child {
  padding-bottom: 0;
}

.step-index {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  flex-shrink: 0;
  border-radius: 8rpx;
  background: #d54941;
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 44rpx;
}

.step-copy {
  flex: 1;
  min-width: 0;
}

.step-title {
  color: #1f241f;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 40rpx;
}

.step-desc {
  margin-top: 6rpx;
  color: #69736d;
  font-size: 26rpx;
  line-height: 40rpx;
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  padding: 18rpx 28rpx calc(env(safe-area-inset-bottom) + 18rpx);
  background: rgba(255, 255, 255, 0.96);
  box-sizing: border-box;
}

.footer-single {
  grid-template-columns: 1fr;
}

.primary-btn,
.secondary-btn {
  height: 84rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 84rpx;
}

.primary-btn {
  background: #d54941;
  color: #fff;
}

.secondary-btn {
  background: #f6f4ef;
  color: #333;
}

.primary-btn::after,
.secondary-btn::after {
  border: 0;
}
