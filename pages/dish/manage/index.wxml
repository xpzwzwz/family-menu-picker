<view class="manage-page">
  <view class="page-head">
    <view class="eyebrow">Dish Library</view>
    <view class="title">管理菜品</view>
    <view class="subtitle">调整队里的常吃菜，之后选菜和随机搭配都会按这里来。</view>
  </view>

  <view class="toolbar">
    <button class="primary-btn" bindtap="goCreate">
      <t-icon name="add" size="32rpx" color="#ffffff" />
      <text>新增菜品</text>
    </button>
    <button class="secondary-btn" bindtap="goCategoryManage">
      <t-icon name="setting" size="32rpx" color="#48613f" />
      <text>管理分类</text>
    </button>
    <button class="restore-btn" wx:if="{{canRestore}}" bindtap="restoreDefaultDishes">恢复初始菜品</button>
  </view>

  <view class="dish-list" wx:if="{{dishList.length}}">
    <view class="dish-card" wx:for="{{dishList}}" wx:key="id">
      <view class="dish-main">
        <view class="dish-title-row">
          <view class="dish-title">{{item.name}}</view>
          <view class="category-pill">{{item.categoryName}}</view>
        </view>
        <view class="dish-meta">{{item.metaText}}</view>
        <view class="dish-tags" wx:if="{{item.tagText}}">{{item.tagText}}</view>
        <view class="dish-notes" wx:if="{{item.notes}}">{{item.notes}}</view>
      </view>
      <view class="dish-actions">
        <button class="action-btn edit-btn" catchtap="editDish" data-id="{{item.id}}">编辑</button>
        <button class="action-btn delete-btn" catchtap="deleteDish" data-id="{{item.id}}">移除</button>
      </view>
    </view>
  </view>

  <view class="empty-state" wx:else>
    <view class="empty-title">菜品库空了</view>
    <view class="empty-desc">先加几道队里常吃的菜，之后选菜和随机搭配都会用到。</view>
    <button class="empty-btn" bindtap="goCreate">新增菜品</button>
  </view>

  <t-dialog id="t-dialog" />
  <t-toast id="t-toast" />
</view>
