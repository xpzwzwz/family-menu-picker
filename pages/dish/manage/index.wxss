page {
  background-color: #f6f4ef;
}

.manage-page {
  min-height: 100vh;
  padding: 28rpx 28rpx 48rpx;
  box-sizing: border-box;
}

.page-head {
  padding: 28rpx 8rpx 24rpx;
}

.eyebrow {
  color: #d54941;
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 0;
}

.title {
  margin-top: 8rpx;
  color: #1f1f1f;
  font-size: 48rpx;
  font-weight: 700;
  line-height: 64rpx;
}

.subtitle {
  margin-top: 12rpx;
  color: #666;
  font-size: 28rpx;
  line-height: 42rpx;
}

.toolbar {
  display: grid;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.primary-btn,
.empty-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  height: 84rpx;
  border-radius: 8rpx;
  background: #d54941;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 84rpx;
}

.primary-btn::after,
.restore-btn::after,
.empty-btn::after,
.action-btn::after {
  border: 0;
}

.restore-btn {
  height: 72rpx;
  border-radius: 8rpx;
  background: #fff;
  color: #d54941;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 72rpx;
}

.dish-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.dish-card,
.empty-state {
  border-radius: 8rpx;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(31, 31, 31, 0.06);
}

.dish-card {
  padding: 24rpx;
  box-sizing: border-box;
}

.dish-main {
  min-width: 0;
}

.dish-title-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.dish-title {
  flex: 1;
  min-width: 0;
  color: #1f1f1f;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 44rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.category-pill {
  flex-shrink: 0;
  max-width: 180rpx;
  padding: 0 14rpx;
  border-radius: 8rpx;
  background: #fff0ee;
  color: #d54941;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 44rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dish-meta {
  margin-top: 10rpx;
  color: #666;
  font-size: 26rpx;
  line-height: 38rpx;
}

.dish-tags,
.dish-notes {
  margin-top: 8rpx;
  color: #888;
  font-size: 24rpx;
  line-height: 36rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dish-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 22rpx;
}

.action-btn {
  height: 64rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 64rpx;
}

.edit-btn {
  background: #fff0ee;
  color: #d54941;
}

.delete-btn {
  background: #f7f7f7;
  color: #666;
}

.empty-state {
  padding: 40rpx 28rpx;
  box-sizing: border-box;
}

.empty-title {
  color: #1f1f1f;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 44rpx;
}

.empty-desc {
  margin-top: 10rpx;
  color: #777;
  font-size: 26rpx;
  line-height: 40rpx;
}

.empty-btn {
  margin-top: 28rpx;
}
