page {
  background: #f4f5f1;
  min-height: 100vh;
}

.confirm-page {
  padding: 28rpx 24rpx calc(env(safe-area-inset-bottom) + 48rpx);
}

.confirm-head,
.summary-card,
.menu-card,
.confirm-footer {
  background: #ffffff;
  border-radius: 8rpx;
}

.confirm-head {
  align-items: center;
  display: flex;
  justify-content: space-between;
  padding: 28rpx;
}

.eyebrow {
  color: #6c7a62;
  font-size: 22rpx;
  letter-spacing: 0;
  line-height: 32rpx;
}

.title {
  color: #1f241f;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 54rpx;
  margin-top: 6rpx;
}

.back-btn {
  background: #eef4e7;
  border-radius: 8rpx;
  color: #48613f;
  font-size: 26rpx;
  height: 72rpx;
  line-height: 72rpx;
  margin: 0;
  padding: 0 22rpx;
}

.summary-card {
  display: grid;
  gap: 1rpx;
  grid-template-columns: 1fr 1fr;
  margin-top: 18rpx;
  overflow: hidden;
}

.summary-item {
  padding: 26rpx;
  text-align: center;
}

.summary-value {
  color: #e34d59;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 58rpx;
}

.summary-label {
  color: #69736d;
  font-size: 24rpx;
  line-height: 34rpx;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 18rpx;
}

.tag-row text {
  background: #ffffff;
  border-radius: 6rpx;
  color: #48613f;
  font-size: 22rpx;
  line-height: 30rpx;
  padding: 8rpx 12rpx;
}

.menu-list {
  display: grid;
  gap: 18rpx;
  margin-top: 18rpx;
}

.menu-card {
  display: flex;
  overflow: hidden;
  padding: 18rpx;
}

.dish-image {
  flex-shrink: 0;
  height: 156rpx;
  width: 156rpx;
}

.dish-info {
  flex: 1;
  min-width: 0;
  padding: 0 18rpx;
}

.dish-title {
  color: #1f241f;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 42rpx;
}

.dish-meta,
.dish-note,
.empty-desc {
  color: #69736d;
  font-size: 24rpx;
  line-height: 34rpx;
}

.dish-meta {
  margin-top: 6rpx;
}

.dish-note {
  margin-top: 8rpx;
}

.dish-quantity {
  color: #1f241f;
  flex-shrink: 0;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 42rpx;
}

.empty-state,
.note-card {
  background: #ffffff;
  border-radius: 8rpx;
  margin-top: 18rpx;
  padding: 28rpx;
}

.empty-title,
.note-title {
  color: #1f241f;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 42rpx;
}

.empty-desc {
  margin-top: 8rpx;
}

.note-title {
  margin-bottom: 18rpx;
}

.confirm-footer {
  box-sizing: border-box;
  margin-top: 18rpx;
  padding: 18rpx;
}

.confirm-btn {
  background: #e34d59;
  border-radius: 8rpx;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  height: 84rpx;
  line-height: 84rpx;
}

.confirm-btn::after,
.back-btn::after {
  border: 0;
}

.result-page {
  min-height: 100vh;
  padding: 56rpx 28rpx calc(env(safe-area-inset-bottom) + 48rpx);
  box-sizing: border-box;
  background: #f4f5f1;
}

.result-card {
  padding: 48rpx 32rpx;
  border-radius: 8rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(31, 31, 31, 0.06);
  text-align: center;
}

.result-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
  margin: 0 auto;
  border-radius: 8rpx;
  background: #d54941;
}

.result-title {
  margin-top: 28rpx;
  color: #1f241f;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 58rpx;
}

.result-desc {
  margin-top: 16rpx;
  color: #69736d;
  font-size: 28rpx;
  line-height: 42rpx;
}

.result-summary {
  margin-top: 24rpx;
  color: #d54941;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 40rpx;
}

.result-actions {
  display: grid;
  gap: 18rpx;
  margin-top: 24rpx;
}

.result-btn {
  height: 84rpx;
  border-radius: 8rpx;
  background: #ffffff;
  color: #333;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 84rpx;
}

.primary-result-btn {
  background: #d54941;
  color: #ffffff;
}

.result-btn::after {
  border: 0;
}
