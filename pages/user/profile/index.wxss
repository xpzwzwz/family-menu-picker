page {
  background-color: #f6f4ef;
}

.profile-page {
  min-height: 100vh;
  padding: 28rpx 28rpx 48rpx;
  box-sizing: border-box;
}

.page-head {
  padding: 28rpx 8rpx 24rpx;
}

.eyebrow {
  color: #d54941;
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 0;
}

.title {
  margin-top: 8rpx;
  color: #1f1f1f;
  font-size: 48rpx;
  font-weight: 700;
  line-height: 64rpx;
}

.subtitle {
  margin-top: 12rpx;
  color: #666;
  font-size: 28rpx;
  line-height: 42rpx;
}

.form-section {
  padding: 28rpx 24rpx;
  border-radius: 8rpx;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(31, 31, 31, 0.06);
}

.cloud-card {
  margin-bottom: 22rpx;
  padding: 24rpx;
  border-radius: 8rpx;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(31, 31, 31, 0.06);
}

.cloud-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.card-label {
  margin-bottom: 16rpx;
  color: #777;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 34rpx;
}

.room-name-area {
  flex: 1;
  min-width: 0;
}

.room-name-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.room-edit {
  display: grid;
  gap: 12rpx;
}

.room-name-input {
  height: 72rpx;
  padding: 0 20rpx;
  border-radius: 8rpx;
  background: #f7f7f7;
  color: #1f1f1f;
  font-size: 28rpx;
  box-sizing: border-box;
}

.room-edit-actions {
  display: flex;
  justify-content: flex-start;
  gap: 12rpx;
}

.cloud-title {
  min-width: 0;
  color: #1f1f1f;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 42rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cloud-value,
.cloud-error,
.join-desc {
  margin-top: 6rpx;
  color: #777;
  font-size: 24rpx;
  line-height: 34rpx;
  word-break: break-all;
}

.cloud-error {
  color: #d54941;
}

.phone-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 20rpx;
  padding: 18rpx;
  border-radius: 8rpx;
  background: #f7f7f7;
}

.phone-copy {
  flex: 1;
  min-width: 0;
}

.phone-title {
  color: #1f1f1f;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 40rpx;
}

.phone-desc {
  margin-top: 4rpx;
  color: #777;
  font-size: 24rpx;
  line-height: 34rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.phone-btn {
  width: 116rpx;
  height: 60rpx;
  padding: 0;
  border-radius: 8rpx;
  background: #26332c;
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 60rpx;
}

.cloud-members {
  display: grid;
  gap: 14rpx;
  margin-top: 20rpx;
}

.cloud-member {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx;
  border-radius: 8rpx;
  background: #f7f7f7;
}

.member-edit {
  display: grid;
  gap: 12rpx;
  margin-top: 14rpx;
  padding: 16rpx;
  border-radius: 8rpx;
  background: #f7f7f7;
}

.mini-btn {
  width: 104rpx;
  height: 56rpx;
  padding: 0;
  border-radius: 8rpx;
  background: #fff0ee;
  color: #d54941;
  font-size: 24rpx;
  line-height: 56rpx;
}

.text-btn {
  width: auto;
  min-width: 104rpx;
  height: 52rpx;
  margin: 0;
  padding: 0 18rpx;
  border-radius: 8rpx;
  background: #fff0ee;
  color: #d54941;
  font-size: 24rpx;
  line-height: 52rpx;
}

.text-btn.muted {
  background: #f7f7f7;
  color: #666;
}

.leave-btn {
  height: 72rpx;
  margin-top: 20rpx;
  border-radius: 8rpx;
  background: #f7f7f7;
  color: #666;
  font-size: 26rpx;
  line-height: 72rpx;
}

.leave-btn.danger {
  background: #fff0ee;
  color: #d54941;
}

.join-preview {
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 8rpx;
  background: #f7f7f7;
}

.entry-list {
  display: grid;
  gap: 14rpx;
}

.entry-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 18rpx;
  border-radius: 8rpx;
  background: #f7f7f7;
}

.entry-copy {
  flex: 1;
  min-width: 0;
}

.entry-title {
  color: #1f1f1f;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 40rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.entry-desc {
  margin-top: 4rpx;
  color: #777;
  font-size: 24rpx;
  line-height: 34rpx;
  word-break: break-all;
}

.join-title {
  color: #1f1f1f;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 40rpx;
}

.member-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
  border-radius: 8rpx;
  background: #26332c;
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 72rpx;
}

.member-copy {
  flex: 1;
  min-width: 0;
}

.member-name {
  color: #1f1f1f;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 42rpx;
}

.member-meta,
.member-pref {
  margin-top: 2rpx;
  color: #777;
  font-size: 24rpx;
  line-height: 34rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.field {
  margin-bottom: 28rpx;
}

.field:last-child {
  margin-bottom: 0;
}

.field-label {
  margin-bottom: 12rpx;
  color: #333;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 40rpx;
}

.field-input {
  height: 88rpx;
  padding: 0 24rpx;
  border-radius: 8rpx;
  background: #f7f7f7;
  color: #1f1f1f;
  font-size: 28rpx;
  box-sizing: border-box;
}

.save-btn {
  height: 92rpx;
  border-radius: 8rpx;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 92rpx;
}

.save-btn {
  background: #d54941;
  color: #fff;
}

.save-btn[disabled] {
  background: #e5e5e5;
  color: #999;
}

.save-btn::after,
.phone-btn::after,
.mini-btn::after,
.text-btn::after,
.leave-btn::after {
  border: 0;
}
