page {
  background-color: #f6f4ef;
}

.profile-page {
  min-height: 100vh;
  padding: 28rpx 28rpx 48rpx;
  box-sizing: border-box;
}

.page-head {
  padding: 28rpx 8rpx 24rpx;
}

.eyebrow {
  color: #d54941;
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 0;
}

.title {
  margin-top: 8rpx;
  color: #1f1f1f;
  font-size: 48rpx;
  font-weight: 700;
  line-height: 64rpx;
}

.subtitle {
  margin-top: 12rpx;
  color: #666;
  font-size: 28rpx;
  line-height: 42rpx;
}

.form-section {
  padding: 28rpx 24rpx;
  border-radius: 8rpx;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(31, 31, 31, 0.06);
}

.member-list {
  display: grid;
  gap: 18rpx;
  margin-bottom: 22rpx;
}

.member-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 22rpx;
  border-radius: 8rpx;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(31, 31, 31, 0.06);
}

.member-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
  border-radius: 8rpx;
  background: #26332c;
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 72rpx;
}

.member-copy {
  flex: 1;
  min-width: 0;
}

.member-name {
  color: #1f1f1f;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 42rpx;
}

.member-meta,
.member-pref {
  margin-top: 2rpx;
  color: #777;
  font-size: 24rpx;
  line-height: 34rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.member-actions {
  display: grid;
  gap: 8rpx;
  flex-shrink: 0;
}

.text-btn {
  width: 92rpx;
  height: 48rpx;
  padding: 0;
  border-radius: 8rpx;
  background: #fff0ee;
  color: #d54941;
  font-size: 24rpx;
  line-height: 48rpx;
}

.muted-btn {
  background: #f7f7f7;
  color: #777;
}

.field {
  margin-bottom: 28rpx;
}

.field:last-child {
  margin-bottom: 0;
}

.field-label {
  margin-bottom: 12rpx;
  color: #333;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 40rpx;
}

.field-input {
  height: 88rpx;
  padding: 0 24rpx;
  border-radius: 8rpx;
  background: #f7f7f7;
  color: #1f1f1f;
  font-size: 28rpx;
  box-sizing: border-box;
}

.footer {
  display: grid;
  gap: 16rpx;
  margin-top: 32rpx;
  padding-bottom: env(safe-area-inset-bottom);
}

.save-btn,
.cancel-btn {
  height: 92rpx;
  border-radius: 8rpx;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 92rpx;
}

.save-btn {
  background: #d54941;
  color: #fff;
}

.cancel-btn {
  background: #fff;
  color: #666;
}

.save-btn::after,
.cancel-btn::after,
.text-btn::after {
  border: 0;
}
