<view class="profile-page">
  <view class="page-head">
    <view class="eyebrow">Squad</view>
    <view class="title">小分队成员</view>
    <view class="subtitle">先在本机维护一起吃饭的人。正式多人共享需要接入云端后让成员加入同一个小分队。</view>
  </view>

  <view class="member-list">
    <view class="member-card" wx:for="{{members}}" wx:key="id">
      <view class="member-avatar">{{item.name.slice(0, 1)}}</view>
      <view class="member-copy">
        <view class="member-name">{{item.name}}</view>
        <view class="member-meta">{{item.role}}</view>
        <view class="member-pref" wx:if="{{item.flavorPreference}}">{{item.flavorPreference}}</view>
      </view>
      <view class="member-actions">
        <button class="text-btn" catchtap="startEdit" data-id="{{item.id}}">编辑</button>
        <button class="text-btn muted-btn" wx:if="{{!item.isSelf}}" catchtap="removeMember" data-id="{{item.id}}">移除</button>
      </view>
    </view>
  </view>

  <view class="form-section">
    <view class="field">
      <view class="field-label">成员名称</view>
      <input class="field-input" value="{{form.name}}" placeholder="例如：小王、妈妈、室友 A" data-field="name" bindinput="updateField" />
    </view>

    <view class="field">
      <view class="field-label">角色</view>
      <input class="field-input" value="{{form.role}}" placeholder="例如：掌勺人、采购员、爱吃辣" data-field="role" bindinput="updateField" />
    </view>

    <view class="field">
      <view class="field-label">口味偏好</view>
      <input
        class="field-input"
        value="{{form.flavorPreference}}"
        placeholder="例如：少辣、多汤、偏清淡"
        data-field="flavorPreference"
        bindinput="updateField"
      />
    </view>
  </view>

  <view class="footer">
    <button class="cancel-btn" wx:if="{{editingId}}" bindtap="resetForm">取消编辑</button>
    <button class="save-btn" bindtap="saveProfile">{{submitText}}</button>
  </view>

  <t-toast id="t-toast" />
</view>
