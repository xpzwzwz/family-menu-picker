<view class="profile-page">
  <view class="page-head">
    <view class="eyebrow">Squad</view>
    <view class="title">我的小分队</view>
    <view class="subtitle">把这份菜单留给自己和队员。添加手机号后，下次进来还能认出你。</view>
  </view>

  <view class="cloud-card">
    <view class="me-row">
      <button class="avatar-btn" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar">
        <image wx:if="{{cloudUser.avatarUrl}}" class="avatar-img" src="{{cloudUser.avatarUrl}}" mode="aspectFill" />
        <view wx:else class="avatar-ph"><t-icon name="user-1" size="48rpx" color="#9aa39c" /></view>
        <view class="avatar-cam"><t-icon name="camera" size="22rpx" color="#ffffff" /></view>
      </button>
      <view class="me-copy">
        <view class="cloud-title">我</view>
        <view class="cloud-value">{{avatarUploading ? '正在上传头像…' : (cloudUser ? '点头像可换一张' : '正在准备你的小分队菜单...')}}</view>
      </view>
    </view>
    <view class="phone-row" wx:if="{{cloudUser}}">
      <view class="phone-copy">
        <view class="phone-title">{{cloudUser.hasPhone ? '已添加手机号' : '添加手机号'}}</view>
        <view class="phone-desc">{{cloudUser.hasPhone ? cloudUser.maskedPhone : '方便以后找回你的小分队菜单。'}}</view>
      </view>
      <button
        class="phone-btn"
        open-type="getPhoneNumber"
        bindgetphonenumber="bindPhone"
        loading="{{phoneBinding}}"
        disabled="{{phoneBinding}}"
      >
        {{cloudUser.hasPhone ? '更换' : '添加'}}
      </button>
    </view>
    <view class="cloud-error" wx:if="{{cloudError}}">{{cloudError}}</view>
  </view>

  <view class="cloud-card" wx:if="{{cloudRoom}}">
    <view class="card-label">当前小分队</view>
    <view class="cloud-head">
      <view class="room-name-area">
        <view class="room-name-row" wx:if="{{!editingRoomName}}">
          <view class="cloud-title">{{cloudRoom.name}}</view>
          <button class="text-btn" wx:if="{{isRoomOwner}}" bindtap="startEditRoomName">编辑名称</button>
        </view>
        <view class="room-edit" wx:else>
          <input
            class="room-name-input"
            value="{{roomNameDraft}}"
            data-field="roomNameDraft"
            bindinput="updateCloudField"
            maxlength="20"
          />
          <view class="room-edit-actions">
            <button class="text-btn muted" bindtap="cancelEditRoomName" disabled="{{roomSaving}}">取消</button>
            <button class="text-btn" bindtap="saveRoomName" loading="{{roomSaving}}" disabled="{{roomSaving}}"
              >保存名称</button
            >
          </view>
        </view>
        <view class="cloud-value">加入口令 {{cloudRoom.inviteCode}}</view>
      </view>
      <button class="mini-btn" open-type="share">分享</button>
    </view>
    <view class="cloud-members">
      <view class="cloud-member" wx:for="{{cloudRoom.members}}" wx:key="userId">
        <image wx:if="{{item.avatarUrl}}" class="member-avatar member-avatar-img" src="{{item.avatarUrl}}" mode="aspectFill" />
        <view wx:else class="member-avatar">{{item.name.slice(0, 1)}}</view>
        <view class="member-copy">
          <view class="member-name">{{item.name}}</view>
          <view class="member-meta">{{item.role}}</view>
          <view class="member-pref" wx:if="{{item.flavorPreference}}">{{item.flavorPreference}}</view>
        </view>
        <button
          class="text-btn"
          wx:if="{{cloudUser && item.userId === cloudUser.userId && !editingMemberName}}"
          bindtap="startEditMemberName"
          >编辑我的名字</button
        >
      </view>
    </view>
    <view class="member-edit" wx:if="{{editingMemberName}}">
      <input
        class="room-name-input"
        value="{{memberNameDraft}}"
        data-field="memberNameDraft"
        bindinput="updateCloudField"
        maxlength="20"
      />
      <view class="room-edit-actions">
        <button class="text-btn muted" bindtap="cancelEditMemberName" disabled="{{memberSaving}}">取消</button>
        <button class="text-btn" bindtap="saveMemberName" loading="{{memberSaving}}" disabled="{{memberSaving}}"
          >保存名字</button
        >
      </view>
    </view>
    <button class="leave-btn danger" wx:if="{{isRoomOwner}}" bindtap="disbandRoom">解散这个小分队</button>
    <button class="leave-btn" wx:else bindtap="leaveRoom">离开这个小分队</button>
  </view>

  <view class="cloud-card">
    <view class="card-label">管理</view>
    <view class="entry-list">
      <view class="entry-item" data-page="list" bindtap="openSquadPage">
        <view class="entry-copy">
          <view class="entry-title">查看小分队</view>
          <view class="entry-desc">切换当前小分队，查看队员和口令。</view>
        </view>
        <t-icon name="chevron-right" size="36rpx" color="#999" />
      </view>
      <view class="entry-item" data-page="create" bindtap="openSquadPage">
        <view class="entry-copy">
          <view class="entry-title">创建小分队</view>
          <view class="entry-desc">开一个新的小分队菜单。</view>
        </view>
        <t-icon name="chevron-right" size="36rpx" color="#999" />
      </view>
      <view class="entry-item" data-page="join" bindtap="openSquadPage">
        <view class="entry-copy">
          <view class="entry-title">加入小分队</view>
          <view class="entry-desc">输入队友分享的口令加入。</view>
        </view>
        <t-icon name="chevron-right" size="36rpx" color="#999" />
      </view>
    </view>
  </view>

  <t-toast id="t-toast" />
</view>
