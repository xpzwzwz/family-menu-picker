<view class="feedback-page">
  <view class="page-head">
    <view class="eyebrow">Idea</view>
    <view class="title">提个想法</view>
    <view class="subtitle">先记在这里，方便你回头整理给我们。</view>
  </view>

  <view class="form-section">
    <view class="field">
      <view class="field-label">想说哪一类</view>
      <view class="chip-row">
        <view
          class="chip {{form.type === item.value ? 'chip-active' : ''}}"
          wx:for="{{feedbackTypes}}"
          wx:key="value"
          data-value="{{item.value}}"
          bindtap="selectType"
        >
          {{item.label}}
        </view>
      </view>
    </view>

    <view class="field">
      <view class="field-label">具体想法</view>
      <t-textarea
        value="{{form.content}}"
        placeholder="例如：希望能按早餐/午餐筛选。"
        maxlength="{{200}}"
        data-field="content"
        bindchange="updateField"
      />
    </view>

    <view class="field">
      <view class="field-label">怎么联系你（选填）</view>
      <input
        class="field-input"
        value="{{form.contact}}"
        placeholder="微信号或手机号，方便追问"
        data-field="contact"
        bindinput="updateField"
      />
    </view>
  </view>

  <view class="footer">
    <button class="submit-btn" bindtap="submit">记下来</button>
  </view>

  <t-toast id="t-toast" />
</view>
