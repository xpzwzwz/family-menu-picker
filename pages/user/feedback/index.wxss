page {
  background-color: #f6f4ef;
}

.feedback-page {
  min-height: 100vh;
  padding: 28rpx 28rpx 48rpx;
  box-sizing: border-box;
}

.page-head {
  padding: 28rpx 8rpx 24rpx;
}

.eyebrow {
  color: #48613f;
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 0;
}

.title {
  margin-top: 8rpx;
  color: #1f1f1f;
  font-size: 48rpx;
  font-weight: 700;
  line-height: 64rpx;
}

.subtitle {
  margin-top: 12rpx;
  color: #666;
  font-size: 28rpx;
  line-height: 42rpx;
}

.form-section {
  padding: 28rpx 24rpx;
  border-radius: 8rpx;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(31, 31, 31, 0.06);
}

.field {
  margin-bottom: 28rpx;
}

.field:last-child {
  margin-bottom: 0;
}

.field-label {
  margin-bottom: 12rpx;
  color: #333;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 40rpx;
}

.field-input {
  height: 88rpx;
  padding: 0 24rpx;
  border-radius: 8rpx;
  background: #f7f7f7;
  color: #1f1f1f;
  font-size: 28rpx;
  box-sizing: border-box;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.chip {
  min-height: 64rpx;
  padding: 0 22rpx;
  border-radius: 8rpx;
  background: #f7f7f7;
  color: #555;
  font-size: 26rpx;
  line-height: 64rpx;
  box-sizing: border-box;
}

.chip-active {
  background: #eef4e7;
  color: #48613f;
  font-weight: 600;
}

.footer {
  margin-top: 32rpx;
  padding-bottom: env(safe-area-inset-bottom);
}

.submit-btn {
  height: 92rpx;
  border-radius: 8rpx;
  background: #48613f;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 92rpx;
}

.submit-btn::after {
  border: 0;
}
