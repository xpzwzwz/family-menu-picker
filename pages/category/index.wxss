page {
  background: #f4f5f1;
  min-height: 100vh;
  overflow: hidden;
}

.category-page {
  height: 100vh;
  padding: 22rpx 18rpx calc(env(safe-area-inset-bottom) + 112rpx);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.page-head {
  flex-shrink: 0;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 10rpx 6rpx 18rpx;
}

.member-strip {
  flex-shrink: 0;
  width: 100%;
  white-space: nowrap;
  padding: 0 0 16rpx;
  box-sizing: border-box;
}

.member-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 128rpx;
  height: 56rpx;
  margin-right: 12rpx;
  padding: 0 18rpx;
  border-radius: 8rpx;
  background: #ffffff;
  color: #69736d;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 56rpx;
  box-sizing: border-box;
}

.member-chip-active {
  background: #48613f;
  color: #ffffff;
}

.eyebrow {
  color: #6c7a62;
  font-size: 22rpx;
  letter-spacing: 0;
  line-height: 32rpx;
}

.title {
  margin-top: 4rpx;
  color: #1f241f;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 54rpx;
}

.head-copy {
  color: #69736d;
  font-size: 24rpx;
  line-height: 36rpx;
}

.picker-shell {
  display: grid;
  grid-template-columns: 160rpx minmax(0, 1fr);
  gap: 16rpx;
}

.category-sidebar,
.dish-scroll {
  height: 100%;
}

.category-sidebar {
  border-radius: 8rpx;
  background: #eceee8;
  overflow: hidden;
}

.category-tab {
  position: relative;
  min-height: 116rpx;
  padding: 22rpx 14rpx 18rpx 22rpx;
  box-sizing: border-box;
  color: #69736d;
}

.category-tab-active {
  background: #ffffff;
  color: #1f241f;
}

.category-tab-active::before {
  position: absolute;
  left: 0;
  top: 24rpx;
  width: 8rpx;
  height: 52rpx;
  border-radius: 0 8rpx 8rpx 0;
  background: #48613f;
  content: '';
}

.category-tab-name {
  font-size: 26rpx;
  font-weight: 700;
  line-height: 36rpx;
}

.category-tab-count {
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 30rpx;
}

.dish-section {
  margin-bottom: 18rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 6rpx 4rpx 14rpx;
}

.section-title {
  color: #1f241f;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 46rpx;
}

.section-desc {
  margin-top: 2rpx;
  color: #69736d;
  font-size: 23rpx;
  line-height: 32rpx;
}

.section-count {
  flex-shrink: 0;
  padding: 6rpx 10rpx;
  border-radius: 6rpx;
  background: #eef4e7;
  color: #48613f;
  font-size: 22rpx;
  line-height: 30rpx;
}

.dish-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 164rpx;
  margin-bottom: 12rpx;
  padding: 16rpx;
  border-radius: 8rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.dish-image {
  flex-shrink: 0;
  width: 116rpx;
  height: 116rpx;
  border-radius: 8rpx;
  overflow: hidden;
}

.dish-info {
  flex: 1;
  min-width: 0;
}

.dish-title {
  color: #1f241f;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 38rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dish-meta {
  margin-top: 6rpx;
  color: #69736d;
  font-size: 22rpx;
  line-height: 32rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dish-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 6rpx;
  margin-top: 10rpx;
  max-height: 42rpx;
  overflow: hidden;
}

.dish-tags text {
  padding: 4rpx 8rpx;
  border-radius: 6rpx;
  background: #f4f5f1;
  color: #69736d;
  font-size: 20rpx;
  line-height: 28rpx;
}

.add-btn {
  flex-shrink: 0;
  width: 56rpx;
  height: 56rpx;
  padding: 0;
  border-radius: 8rpx;
  background: #48613f;
  color: #ffffff;
  font-size: 36rpx;
  font-weight: 600;
  line-height: 52rpx;
}

.add-btn::after {
  border: 0;
}

.scroll-bottom {
  height: 24rpx;
}

/* 搜索 */
.search-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
  padding: 14rpx 24rpx;
  background: #ffffff;
  border-radius: 40rpx;
}

.search-input {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: #1f241f;
}

.search-shell {
  box-sizing: border-box;
}

.search-scroll {
  box-sizing: border-box;
}

.search-empty {
  padding: 90rpx 40rpx;
  text-align: center;
}

.search-empty-title {
  color: #1f241f;
  font-size: 30rpx;
  font-weight: 700;
}

.search-empty-sub {
  margin-top: 12rpx;
  color: #9aa39c;
  font-size: 26rpx;
  line-height: 38rpx;
}
