page {
  background-color: #f6f4ef;
}

.basket-page {
  min-height: 100vh;
  padding: 28rpx 28rpx calc(env(safe-area-inset-bottom) + 132rpx);
  box-sizing: border-box;
}

.page-head {
  padding: 28rpx 8rpx 24rpx;
}

.eyebrow {
  color: #48613f;
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 0;
}

.title {
  margin-top: 8rpx;
  color: #1f1f1f;
  font-size: 48rpx;
  font-weight: 700;
  line-height: 64rpx;
}

.subtitle {
  margin-top: 12rpx;
  color: #666;
  font-size: 28rpx;
  line-height: 42rpx;
}

.summary-card,
.ingredient-list,
.empty-state {
  border-radius: 8rpx;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(31, 31, 31, 0.06);
}

.summary-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 24rpx;
  box-sizing: border-box;
}

.summary-title {
  color: #1f241f;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 42rpx;
}

.summary-desc {
  margin-top: 6rpx;
  color: #69736d;
  font-size: 24rpx;
  line-height: 34rpx;
}

.clear-btn {
  flex-shrink: 0;
  width: 144rpx;
  height: 60rpx;
  padding: 0;
  border-radius: 8rpx;
  background: #f6f4ef;
  color: #666;
  font-size: 24rpx;
  line-height: 60rpx;
}

.ingredient-list {
  margin-top: 20rpx;
  overflow: hidden;
}

.ingredient-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 112rpx;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #f0eee9;
  box-sizing: border-box;
}

.ingredient-item:last-child {
  border-bottom: 0;
}

.ingredient-checked {
  background: #fbfaf7;
}

.ingredient-copy {
  flex: 1;
  min-width: 0;
}

.ingredient-name {
  color: #1f241f;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 42rpx;
}

.ingredient-checked .ingredient-name {
  color: #999;
  text-decoration: line-through;
}

.ingredient-meta {
  margin-top: 4rpx;
  color: #777;
  font-size: 24rpx;
  line-height: 34rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.share-row {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.copy-btn,
.share-btn2 {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.copy-btn {
  background: #f3c969;
  color: #1f241f;
}

.share-btn2 {
  background: #fff;
  color: #48613f;
  border: 2rpx solid #d8e0d2;
}

.copy-btn::after,
.share-btn2::after {
  border: 0;
}

.ingredient-group {
  margin-top: 20rpx;
  border-radius: 8rpx;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(31, 31, 31, 0.06);
  overflow: hidden;
}

.group-head {
  display: flex;
  align-items: center;
  padding: 18rpx 24rpx;
  border-bottom: 1rpx solid #f0eee9;
}

.group-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.group-label {
  color: #1f241f;
  font-size: 28rpx;
  font-weight: 700;
}

.group-count {
  margin-left: auto;
  color: #9aa39c;
  font-size: 24rpx;
}

.group-chevron {
  margin-left: 12rpx;
  transition: transform 0.2s ease;
}

.group-chevron-open {
  transform: rotate(180deg);
}

.groups-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  padding: 0 8rpx;
}

.groups-hint {
  color: #9aa39c;
  font-size: 22rpx;
}

.groups-toggle-all {
  color: #48613f;
  font-size: 24rpx;
  font-weight: 600;
}

.empty-state {
  margin-top: 20rpx;
  padding: 40rpx 28rpx;
  box-sizing: border-box;
}

.empty-title {
  color: #1f1f1f;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 44rpx;
}

.empty-desc {
  margin-top: 10rpx;
  color: #777;
  font-size: 26rpx;
  line-height: 40rpx;
}

.empty-btn {
  margin-top: 28rpx;
  height: 76rpx;
  border-radius: 8rpx;
  background: #48613f;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 76rpx;
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  padding: 18rpx 28rpx calc(env(safe-area-inset-bottom) + 18rpx);
  background: rgba(255, 255, 255, 0.96);
  box-sizing: border-box;
}

.primary-btn,
.secondary-btn {
  height: 84rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 84rpx;
}

.primary-btn {
  background: #48613f;
  color: #fff;
}

.secondary-btn {
  background: #f6f4ef;
  color: #333;
}

.clear-btn::after,
.empty-btn::after,
.primary-btn::after,
.secondary-btn::after {
  border: 0;
}
