page {
  background-color: #f6f4ef;
}

.history-page {
  min-height: 100vh;
  padding: 28rpx 28rpx 48rpx;
  box-sizing: border-box;
}

.page-head {
  padding: 28rpx 8rpx 24rpx;
}

.eyebrow {
  color: #d54941;
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 0;
}

.title {
  margin-top: 8rpx;
  color: #1f1f1f;
  font-size: 48rpx;
  font-weight: 700;
  line-height: 64rpx;
}

.subtitle {
  margin-top: 12rpx;
  color: #666;
  font-size: 28rpx;
  line-height: 42rpx;
}

.history-list,
.empty-state {
  border-radius: 8rpx;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(31, 31, 31, 0.06);
  overflow: hidden;
}

.history-list {
  padding: 4rpx 24rpx;
  box-sizing: border-box;
}

.history-card {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0eee9;
}

.history-card:last-child {
  border-bottom: 0;
}

.history-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.history-title-wrap {
  flex: 1;
  min-width: 0;
}

.history-time {
  color: #333;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 42rpx;
}

.history-count {
  margin-top: 4rpx;
  color: #d54941;
  font-size: 24rpx;
  line-height: 34rpx;
}

.reuse-btn {
  flex-shrink: 0;
  width: 112rpx;
  height: 56rpx;
  padding: 0;
  border-radius: 8rpx;
  background: #fff0ee;
  color: #d54941;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 56rpx;
}

.reuse-btn::after {
  border: 0;
}

.history-dishes {
  margin-top: 10rpx;
  color: #555;
  font-size: 26rpx;
  line-height: 38rpx;
}

.history-note {
  margin-top: 8rpx;
  color: #888;
  font-size: 24rpx;
  line-height: 36rpx;
}

.empty-state {
  padding: 40rpx 28rpx;
  box-sizing: border-box;
}

.empty-title {
  color: #1f1f1f;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 44rpx;
}

.empty-desc {
  margin-top: 10rpx;
  color: #777;
  font-size: 26rpx;
  line-height: 40rpx;
}
