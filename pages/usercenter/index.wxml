<view class="family-center">
  <view class="center-hero">
    <view class="eyebrow">Family</view>
    <view class="center-title">家庭菜单</view>
    <view class="center-desc">这里管理菜单入口、个人资料和问题反馈。</view>
  </view>

  <view class="profile-card" bindtap="handleAction" data-type="profile">
    <view class="avatar">{{avatarText}}</view>
    <view class="profile-copy">
      <view class="profile-name">{{userProfile.nickname}}</view>
      <view class="profile-meta">{{userProfile.role}}</view>
      <view class="profile-pref" wx:if="{{userProfile.flavorPreference}}">{{userProfile.flavorPreference}}</view>
    </view>
    <t-icon name="chevron-right" size="36rpx" color="#999" />
  </view>

  <view class="menu-summary">当前 {{selectedCount}} 份 · 预计 {{totalCookMinutes}} 分钟</view>

  <view class="section">
    <view class="section-title">快捷入口</view>
    <view class="action-list">
      <view class="action-item" wx:for="{{actionList}}" wx:key="type" bindtap="handleAction" data-type="{{item.type}}">
        <view class="action-icon">
          <t-icon name="{{item.icon}}" size="36rpx" color="#d54941" />
        </view>
        <view class="action-copy">
          <view class="action-title">{{item.title}}</view>
          <view class="action-desc">{{item.desc}}</view>
        </view>
        <t-icon name="chevron-right" size="36rpx" color="#999" />
      </view>
    </view>
  </view>

  <view class="footer__version" wx:if="{{versionNo !== ''}}">当前版本 {{versionNo}}</view>
  <t-toast id="t-toast" />
</view>
