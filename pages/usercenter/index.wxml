<view class="family-center">
  <view class="squad-panel">
    <view class="squad-panel__top">
      <view class="eyebrow">当前小分队</view>
      <button class="manage-btn" bindtap="handleAction" data-type="profile">管理</button>
    </view>
    <view class="panel-id-row">
      <image wx:if="{{cloudUser.avatarUrl}}" class="panel-avatar" src="{{cloudUser.avatarUrl}}" mode="aspectFill" />
      <view wx:else class="panel-avatar panel-avatar-ph"><t-icon name="user-1" size="44rpx" color="#9aa39c" /></view>
      <view class="panel-id-copy">
        <view class="center-title">{{currentSquadName}}</view>
        <view class="center-desc">{{currentIdentityText}}</view>
        <view class="profile-pref" wx:if="{{cloudUser && cloudUser.hasPhone}}">{{cloudUser.maskedPhone}}</view>
      </view>
    </view>
    <view class="menu-stats">
      <view class="menu-stat">
        <view class="menu-stat__value">{{selectedCount}}</view>
        <view class="menu-stat__label">当前份数</view>
      </view>
      <view class="menu-stat">
        <view class="menu-stat__value">{{totalCookMinutes}}</view>
        <view class="menu-stat__label">预计分钟</view>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">快捷入口</view>
    <view class="action-list">
      <view class="action-item" wx:for="{{actionList}}" wx:key="type" bindtap="handleAction" data-type="{{item.type}}">
        <view class="action-icon">
          <t-icon name="{{item.icon}}" size="36rpx" color="#48613f" />
        </view>
        <view class="action-copy">
          <view class="action-title">{{item.title}}</view>
          <view class="action-desc">{{item.desc}}</view>
        </view>
        <t-icon name="chevron-right" size="36rpx" color="#999" />
      </view>
    </view>
  </view>

  <view class="footer__version" wx:if="{{versionNo !== ''}}">当前版本 {{versionNo}}</view>
  <t-toast id="t-toast" />
</view>
