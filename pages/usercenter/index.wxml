<view class="family-center">
  <view class="center-hero">
    <view class="eyebrow">Family</view>
    <view class="center-title">家庭菜单</view>
    <view class="center-desc">这里保留当前选择和最近一次确认结果，首版先不接入地址、订单和支付。</view>
  </view>

  <view class="stats-grid">
    <view class="stat-item">
      <view class="stat-value">{{selectedCount}}</view>
      <view class="stat-label">今晚已选</view>
    </view>
    <view class="stat-item">
      <view class="stat-value">{{totalCookMinutes}}</view>
      <view class="stat-label">预计分钟</view>
    </view>
    <view class="stat-item">
      <view class="stat-value">{{lastConfirmedCount}}</view>
      <view class="stat-label">上次确认</view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">快捷入口</view>
    <view class="action-list">
      <view class="action-item" wx:for="{{actionList}}" wx:key="type" bindtap="handleAction" data-type="{{item.type}}">
        <view class="action-icon">
          <t-icon name="{{item.icon}}" size="36rpx" color="#d54941" />
        </view>
        <view class="action-copy">
          <view class="action-title">{{item.title}}</view>
          <view class="action-desc">{{item.desc}}</view>
        </view>
        <t-icon name="chevron-right" size="36rpx" color="#999" />
      </view>
    </view>
  </view>

  <view class="section last-section">
    <view class="section-title">最近确认</view>
    <view class="last-row">
      <view>
        <view class="last-title">{{lastConfirmedAtText}}</view>
        <view class="last-desc" wx:if="{{lastConfirmedNote}}">{{lastConfirmedNote}}</view>
        <view class="last-desc" wx:else>确认今晚菜单后会显示在这里。</view>
      </view>
      <view class="last-count">{{lastConfirmedCount}} 道</view>
    </view>
  </view>

  <view class="footer__version" wx:if="{{versionNo !== ''}}">当前版本 {{versionNo}}</view>
  <t-toast id="t-toast" />
</view>
