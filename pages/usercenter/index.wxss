page {
  background-color: #f6f4ef;
}

.family-center {
  min-height: 100vh;
  padding: 28rpx 28rpx calc(env(safe-area-inset-bottom) + 180rpx);
  box-sizing: border-box;
}

.squad-panel {
  margin-bottom: 28rpx;
  padding: 28rpx;
  border-radius: 8rpx;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(31, 31, 31, 0.06);
  box-sizing: border-box;
}

.squad-panel__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.eyebrow {
  color: #d54941;
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 0;
}

.center-title {
  margin-top: 16rpx;
  color: #1f1f1f;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 54rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.center-desc {
  margin-top: 8rpx;
  color: #666;
  font-size: 28rpx;
  line-height: 42rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.manage-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 56rpx;
  margin: 0;
  padding: 0;
  border-radius: 8rpx;
  background: #26332c;
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 56rpx;
  box-sizing: border-box;
}

.manage-btn::after {
  border: 0;
}

.profile-pref {
  margin-top: 4rpx;
  color: #999;
  font-size: 24rpx;
  line-height: 34rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.menu-stats {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #f0eee9;
}

.menu-stat {
  min-width: 0;
}

.menu-stat__value {
  color: #333;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 44rpx;
}

.menu-stat__label {
  margin-top: 2rpx;
  color: #777;
  font-size: 24rpx;
  line-height: 34rpx;
}

.section {
  margin-bottom: 28rpx;
}

.section-title {
  margin: 0 8rpx 16rpx;
  color: #333;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 42rpx;
}

.action-list {
  border-radius: 8rpx;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(31, 31, 31, 0.06);
  overflow: hidden;
}

.action-item {
  display: flex;
  align-items: center;
  min-height: 112rpx;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
  border-bottom: 1rpx solid #f0eee9;
}

.action-item:last-child {
  border-bottom: 0;
}

.action-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  margin-right: 20rpx;
  border-radius: 8rpx;
  background: #fff0ee;
}

.action-copy {
  flex: 1;
  min-width: 0;
}

.action-title {
  color: #333;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 42rpx;
}

.action-desc {
  margin-top: 4rpx;
  color: #777;
  font-size: 24rpx;
  line-height: 34rpx;
}

.footer__version {
  text-align: center;
  margin-top: 50rpx;
  color: #999;
  margin-bottom: 4rpx;
  font-size: 24rpx;
  line-height: 32rpx;
}
