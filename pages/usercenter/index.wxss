page {
  background-color: #f6f4ef;
}

.family-center {
  min-height: 100vh;
  padding: 28rpx 28rpx calc(env(safe-area-inset-bottom) + 180rpx);
  box-sizing: border-box;
}

.center-hero {
  padding: 36rpx 8rpx 28rpx;
}

.eyebrow {
  color: #d54941;
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 0;
}

.center-title {
  margin-top: 8rpx;
  color: #1f1f1f;
  font-size: 48rpx;
  font-weight: 700;
  line-height: 64rpx;
}

.center-desc {
  margin-top: 12rpx;
  color: #666;
  font-size: 28rpx;
  line-height: 42rpx;
}

.profile-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 28rpx;
  padding: 24rpx;
  border-radius: 8rpx;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(31, 31, 31, 0.06);
  box-sizing: border-box;
}

.avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  flex-shrink: 0;
  border-radius: 8rpx;
  background: #26332c;
  color: #fff;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 88rpx;
}

.profile-copy {
  flex: 1;
  min-width: 0;
}

.profile-name {
  color: #1f1f1f;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 44rpx;
}

.profile-meta,
.profile-pref {
  margin-top: 4rpx;
  color: #777;
  font-size: 24rpx;
  line-height: 34rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.menu-summary {
  margin: -12rpx 8rpx 28rpx;
  color: #777;
  font-size: 26rpx;
  line-height: 38rpx;
}

.section {
  margin-bottom: 28rpx;
}

.section-title {
  margin: 0 8rpx 16rpx;
  color: #333;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 42rpx;
}

.action-list {
  border-radius: 8rpx;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(31, 31, 31, 0.06);
  overflow: hidden;
}

.action-item {
  display: flex;
  align-items: center;
  min-height: 112rpx;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
  border-bottom: 1rpx solid #f0eee9;
}

.action-item:last-child {
  border-bottom: 0;
}

.action-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  margin-right: 20rpx;
  border-radius: 8rpx;
  background: #fff0ee;
}

.action-copy {
  flex: 1;
  min-width: 0;
}

.action-title {
  color: #333;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 42rpx;
}

.action-desc {
  margin-top: 4rpx;
  color: #777;
  font-size: 24rpx;
  line-height: 34rpx;
}

.footer__version {
  text-align: center;
  margin-top: 50rpx;
  color: #999;
  margin-bottom: 4rpx;
  font-size: 24rpx;
  line-height: 32rpx;
}
