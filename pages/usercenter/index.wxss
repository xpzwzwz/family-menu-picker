page {
  background-color: #f6f4ef;
}

.family-center {
  min-height: 100vh;
  padding: 28rpx 28rpx 48rpx;
  box-sizing: border-box;
}

.center-hero {
  padding: 36rpx 8rpx 28rpx;
}

.eyebrow {
  color: #d54941;
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 0;
}

.center-title {
  margin-top: 8rpx;
  color: #1f1f1f;
  font-size: 48rpx;
  font-weight: 700;
  line-height: 64rpx;
}

.center-desc {
  margin-top: 12rpx;
  color: #666;
  font-size: 28rpx;
  line-height: 42rpx;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.stat-item {
  padding: 24rpx 16rpx;
  border-radius: 8rpx;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(31, 31, 31, 0.06);
}

.stat-value {
  color: #1f1f1f;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 52rpx;
  text-align: center;
}

.stat-label {
  margin-top: 6rpx;
  color: #777;
  font-size: 24rpx;
  line-height: 34rpx;
  text-align: center;
}

.section {
  margin-bottom: 28rpx;
}

.section-title {
  margin: 0 8rpx 16rpx;
  color: #333;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 42rpx;
}

.action-list,
.last-section,
.history-list,
.history-empty {
  border-radius: 8rpx;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(31, 31, 31, 0.06);
  overflow: hidden;
}

.action-item {
  display: flex;
  align-items: center;
  min-height: 112rpx;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
  border-bottom: 1rpx solid #f0eee9;
}

.action-item:last-child {
  border-bottom: 0;
}

.action-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  margin-right: 20rpx;
  border-radius: 8rpx;
  background: #fff0ee;
}

.action-copy {
  flex: 1;
  min-width: 0;
}

.action-title {
  color: #333;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 42rpx;
}

.action-desc {
  margin-top: 4rpx;
  color: #777;
  font-size: 24rpx;
  line-height: 34rpx;
}

.last-section {
  padding: 24rpx;
  box-sizing: border-box;
}

.last-section .section-title {
  margin-left: 0;
}

.last-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.last-title {
  color: #333;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 42rpx;
}

.last-desc {
  margin-top: 8rpx;
  color: #777;
  font-size: 24rpx;
  line-height: 36rpx;
}

.last-count {
  flex-shrink: 0;
  color: #d54941;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 42rpx;
}

.history-list {
  padding: 4rpx 24rpx;
  box-sizing: border-box;
}

.history-card {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0eee9;
}

.history-card:last-child {
  border-bottom: 0;
}

.history-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.history-title-wrap {
  flex: 1;
  min-width: 0;
}

.history-time {
  color: #333;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 40rpx;
}

.history-count {
  margin-top: 4rpx;
  color: #d54941;
  font-size: 24rpx;
  line-height: 34rpx;
}

.reuse-btn {
  flex-shrink: 0;
  width: 112rpx;
  height: 56rpx;
  padding: 0;
  border-radius: 8rpx;
  background: #fff0ee;
  color: #d54941;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 56rpx;
}

.reuse-btn::after {
  border: 0;
}

.history-dishes {
  margin-top: 10rpx;
  color: #555;
  font-size: 26rpx;
  line-height: 38rpx;
}

.history-note {
  margin-top: 8rpx;
  color: #888;
  font-size: 24rpx;
  line-height: 36rpx;
}

.history-empty {
  padding: 32rpx 24rpx;
  box-sizing: border-box;
}

.history-empty-title {
  color: #333;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 40rpx;
}

.history-empty-desc {
  margin-top: 8rpx;
  color: #777;
  font-size: 24rpx;
  line-height: 36rpx;
}

.footer__version {
  text-align: center;
  margin-top: 50rpx;
  color: #999;
  margin-bottom: 4rpx;
  font-size: 24rpx;
  line-height: 32rpx;
}
