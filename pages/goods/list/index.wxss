page {
  background: #f4f5f1;
  min-height: 100vh;
}

.dish-list-page {
  padding: 28rpx 24rpx 40rpx;
}

.list-head {
  align-items: center;
  background: #ffffff;
  border-radius: 8rpx;
  display: flex;
  justify-content: space-between;
  padding: 28rpx;
}

.eyebrow {
  color: #6c7a62;
  font-size: 22rpx;
  letter-spacing: 0;
  line-height: 32rpx;
}

.title {
  color: #1f241f;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 54rpx;
  margin-top: 6rpx;
}

.menu-btn {
  background: #26332c;
  border-radius: 8rpx;
  color: #ffffff;
  font-size: 26rpx;
  height: 72rpx;
  line-height: 72rpx;
  margin: 0;
  padding: 0 22rpx;
}

.empty-wrap {
  margin-top: 160rpx;
}

.dish-list {
  display: grid;
  gap: 18rpx;
  margin-top: 24rpx;
}

.dish-card {
  background: #ffffff;
  border-radius: 8rpx;
  display: flex;
  overflow: hidden;
}

.dish-image {
  flex-shrink: 0;
  height: 220rpx;
  width: 200rpx;
}

.dish-body {
  flex: 1;
  min-width: 0;
  padding: 20rpx;
}

.dish-title-row {
  align-items: flex-start;
  display: flex;
  gap: 12rpx;
  justify-content: space-between;
}

.dish-name {
  color: #1f241f;
  flex: 1;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 42rpx;
}

.dish-time {
  background: #eef4e7;
  border-radius: 6rpx;
  color: #48613f;
  flex-shrink: 0;
  font-size: 22rpx;
  line-height: 30rpx;
  padding: 6rpx 10rpx;
}

.dish-meta {
  color: #69736d;
  font-size: 24rpx;
  line-height: 34rpx;
  margin-top: 8rpx;
}

.dish-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 12rpx;
}

.dish-tags text {
  background: #f4f5f1;
  border-radius: 6rpx;
  color: #69736d;
  font-size: 22rpx;
  line-height: 30rpx;
  padding: 6rpx 10rpx;
}

.add-btn {
  background: #e34d59;
  border-radius: 8rpx;
  color: #ffffff;
  font-size: 26rpx;
  height: 68rpx;
  line-height: 68rpx;
  margin: 18rpx 0 0;
}
