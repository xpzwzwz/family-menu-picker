<view class="dish-list-page">
  <view class="list-head">
    <view>
      <view class="eyebrow">Dishes</view>
      <view class="title">{{categoryName}}</view>
    </view>
    <button class="menu-btn" bindtap="goMenu">今晚菜单</button>
  </view>

  <view class="empty-wrap" wx:if="{{goodsList.length === 0 && hasLoaded}}">
    <t-empty t-class="empty-tips" size="240rpx" description="暂无相关菜品" />
  </view>

  <view class="dish-list" wx:if="{{goodsList.length}}">
    <view class="dish-card" wx:for="{{goodsList}}" wx:key="spuId">
      <t-image src="{{item.thumb}}" t-class="dish-image" mode="aspectFill" />
      <view class="dish-body">
        <view class="dish-title-row">
          <view class="dish-name">{{item.title}}</view>
          <view class="dish-time">{{item.cookMinutes}} 分钟</view>
        </view>
        <view class="dish-meta">{{item.difficulty}} · {{item.flavor}}</view>
        <view class="dish-tags">
          <text wx:for="{{item.tags}}" wx:key="*this">{{item}}</text>
        </view>
        <button class="add-btn" data-index="{{index}}" bindtap="handleAddCart">加入今晚菜单</button>
      </view>
    </view>
  </view>

  <load-more wx:if="{{goodsList.length > 0}}" status="{{loadMoreStatus}}" no-more-text="没有更多菜了" />
  <t-toast id="t-toast" />
</view>
